# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite um .env com segredos reais.

# Chave da API do provedor de LLM usado pelo agente (Agno). Ainda não consumida por código
# em src/data_agent (chega nos próximos dias), mas já documentada aqui e usada como
# placeholder mockado nos testes de CI (.github/workflows/pr-quality-checks.yml).
OPENAI_API_KEY=

# Observabilidade via Langfuse (OpenTelemetry). Ainda não consumida por código em
# src/data_agent (chega nos próximos dias).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Caminho do arquivo DuckDB do warehouse local, gerado por scripts/load_data.py.
DUCKDB_PATH=data/warehouse.duckdb
