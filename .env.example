# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite um .env com segredos reais.

# Chave da API do provedor de LLM usado pelo agente (Agno). Consumida por
# data_agent.config.Settings e repassada ao agno.models.groq.Groq em
# data_agent/agent.py (ver docs/adrs/0006-troca-de-provedor-llm-para-groq.md).
# Usada como placeholder mockado nos testes de CI (.github/workflows/pr-quality-checks.yml).
# O id do modelo (default do Agno: "openai/gpt-oss-120b") não é configurável via
# variável de ambiente hoje — é o único modelo do catálogo gratuito da Groq
# confirmado a suportar tool-calling e structured outputs ao mesmo tempo (ver
# ADR-0006); trocar isso é uma decisão de código em data_agent/agent.py, não de
# variável de ambiente.
GROQ_API_KEY=

# Timeout (segundos) para a chamada ao modelo de linguagem, repassado ao cliente
# Groq via data_agent.config.Settings -> data_agent/agent.py. Estourar esse
# timeout faz data_agent/api.py devolver 504 em POST /ask (ver
# docs/adrs/0005-insufficient-data-como-resposta-valida.md).
# Requer reiniciar o processo da API para ter efeito: get_settings() é @lru_cache
# (lido uma única vez por processo), e o Agent (com o timeout já embutido no
# client Groq) é construído sob demanda e cacheado em data_agent/api.py:get_agent.
GROQ_TIMEOUT_SECONDS=30.0

# Nível de log do structlog usado em data_agent/api.py e nas tools de SQL
# controlado (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Requer reiniciar o processo da API para ter efeito: a configuração do
# structlog (_configure_structlog em data_agent/api.py) roda uma única vez,
# na importação do módulo, não a cada request.
LOG_LEVEL=INFO

# Observabilidade via Langfuse (OpenTelemetry) — ver
# docs/adrs/0007-observabilidade-com-langfuse.md e data_agent/observability.py.
# Public key do projeto Langfuse (Settings > API Keys no dashboard). Não é
# secreta sozinha (só autentica no par com LANGFUSE_SECRET_KEY, via HTTP Basic
# Auth no exportador OTLP), mas ainda assim fica vazia aqui — nunca um valor
# real neste arquivo.
LANGFUSE_PUBLIC_KEY=

# Secret key do projeto Langfuse. Esta, sim, é um segredo de verdade — nunca
# commitar um valor real. Junto com LANGFUSE_PUBLIC_KEY, forma o header
# `Authorization: Basic base64(public_key:secret_key)` que
# data_agent/observability.py monta e passa ao OTLPSpanExporter.
LANGFUSE_SECRET_KEY=

# Host do Langfuse que recebe os traces via OTLP. data_agent/observability.py
# usa isto para montar o endpoint completo (`<LANGFUSE_HOST>/api/public/otel/v1/traces`).
# Default aqui aponta para a região US do Langfuse Cloud (tier gratuito usado
# neste projeto); troque para "https://eu.cloud.langfuse.com" (região EU) ou
# para o host de uma instância self-hosted, se aplicável.
# As 3 variáveis LANGFUSE_* acima requerem reiniciar o processo da API para
# terem efeito: mesmo motivo de LOG_LEVEL/GROQ_TIMEOUT_SECONDS acima —
# `configure_observability()` (data_agent/observability.py) também roda uma
# única vez, na importação de data_agent/api.py, não a cada request.
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Caminho do arquivo DuckDB do warehouse local, gerado por scripts/load_data.py.
DUCKDB_PATH=data/warehouse.duckdb
